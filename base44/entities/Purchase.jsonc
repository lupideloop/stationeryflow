{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "item_id": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "quantity_purchased": {
      "type": "number"
    },
    "unit_price": {
      "type": "number"
    },
    "line_total": {
      "type": "number"
    }
  },
  "required": [
    "date",
    "item_id",
    "quantity_purchased",
    "unit_price"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}