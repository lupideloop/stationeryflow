{
  "name": "Transfer",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "item_id": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "quantity_issued": {
      "type": "number"
    },
    "department": {
      "type": "string",
      "description": "Department name \u2014 matches a Department entity record for this account"
    },
    "unit_price": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "month_year": {
      "type": "string",
      "description": "Format YYYY-MM"
    }
  },
  "required": [
    "date",
    "item_id",
    "quantity_issued",
    "department"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}