{
  "name": "Transfer",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "item_id": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "quantity_issued": {
      "type": "number"
    },
    "department": {
      "type": "string",
      "enum": [
        "Exec Offices + Marketing",
        "FEC",
        "Bay Radio",
        "Accounts Dept",
        "Cynergi",
        "CarPark",
        "Cinema",
        "TEN Ltd",
        "Other"
      ]
    },
    "unit_price": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "month_year": {
      "type": "string",
      "description": "Format YYYY-MM"
    }
  },
  "required": [
    "date",
    "item_id",
    "quantity_issued",
    "department"
  ]
}